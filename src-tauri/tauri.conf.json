{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberNex",
  "version": "2.0.0",
  "mainBinaryName": "cybernex",
  "identifier": "io.github.veerendranadhreddy11.cybergo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "CyberNex", "width": 1340, "height": 900, "minWidth": 390, "minHeight": 580 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
