{
  "name": "cybernex",
  "version": "2.1.0",
  "description": "Offline cybersecurity training with structured and self-paced courses",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/offline.mjs",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "test:browser": "playwright test",
    "desktop": "tauri"
  },
  "private": true,
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
